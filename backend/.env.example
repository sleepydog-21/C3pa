# ==========================================
# Configuración del Entorno - Conect
# ==========================================

PROJECT_NAME="Conect - Colaboración Científica"
API_V1_STR="/api/v1"

# Base de Datos PostgreSQL con pgvector
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/conect_db"

# Claves de Seguridad
SECRET_KEY="cambiar-por-un-secret-key-seguro-en-produccion"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Servicio de LLM (vLLM OpenAI-Compatible del C3 UNAM o OpenAI Oficial)
OPENAI_BASE_URL="https://gptoss.c3.unam.mx/v1"
OPENAI_API_KEY="tu-api-key-del-c3-o-openai-aqui"
OPENAI_CHAT_MODEL="gptoss"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS=1536

# Almacenamiento de archivos (Local o S3/MinIO)
STORAGE_TYPE="local" # "local" o "s3"
LOCAL_STORAGE_DIR="./uploads"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
